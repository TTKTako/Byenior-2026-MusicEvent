REMOTE_PASSWORD=

# GIPHY API key — get your own free key at https://developers.giphy.com/
GIPHY_API_KEY=

# Cloudflare Tunnel token — get it from https://one.dash.cloudflare.com/
# Zero Trust > Networks > Tunnels > Create a tunnel > copy the token
# Configure the tunnel to forward to http://app:3000
TUNNEL_TOKEN=

